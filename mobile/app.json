{
  "expo": {
    "name": "KlassKonnect",
    "slug": "klasskonnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.klasskonnect"
    },
    "android": {
      "package": "com.anonymous.klasskonnect"
    },
    "web": {},
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      "expo-notifications"
    ],
    "scheme": "klasskonnect"
  }
}
